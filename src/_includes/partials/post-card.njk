<article class="post-card">
  <p class="post-meta"><span class="tag">{{ post.data.category }}</span><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.description }}</p>
  <a href="{{ post.url }}" class="link-arrow" aria-hidden="true" tabindex="-1">Read article <svg class="icon"><use href="#i-arrow"/></svg></a>
</article>
