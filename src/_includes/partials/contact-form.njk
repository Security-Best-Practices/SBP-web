{#- Formspree form xrbgnwve: each submission is emailed to the account owner. The script submits with fetch so visitors stay on the page; without JS the form posts normally and Formspree shows its own thank-you page. -#}
<div class="contact-card">
  <form id="contact-form" action="https://formspree.io/f/xrbgnwve" method="POST">
    <div class="form-grid">
      <div class="field-group">
        <label for="f-name">First name</label>
        <input id="f-name" type="text" name="first_name" autocomplete="given-name">
      </div>
      <div class="field-group">
        <label for="f-last">Last name</label>
        <input id="f-last" type="text" name="last_name" autocomplete="family-name">
      </div>
      <div class="field-group span-2">
        <label for="f-company">Company</label>
        <input id="f-company" type="text" name="company" autocomplete="organization">
      </div>
      <div class="field-group">
        <label for="f-email">Work email <span aria-hidden="true">*</span></label>
        <input id="f-email" type="email" name="email" autocomplete="email" required>
      </div>
      <div class="field-group">
        <label for="f-phone">Phone <span aria-hidden="true">*</span></label>
        <input id="f-phone" type="tel" name="phone" autocomplete="tel" required>
      </div>
      <div class="field-group span-2">
        <label for="f-message">How can we help? <span aria-hidden="true">*</span></label>
        <textarea id="f-message" name="message" maxlength="2000" rows="4" required></textarea>
      </div>
    </div>
    {#- Honeypot: Formspree silently drops submissions that fill this in. -#}
    <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="hidden" name="_subject" value="New website inquiry">
    {#- Cloudflare Turnstile: adds a cf-turnstile-response field that Formspree verifies with the secret key stored in its settings. -#}
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAFScG51gEDmPpCKu" data-size="flexible"></div>
    <p class="form-error" role="alert" hidden></p>
    <button type="submit" class="btn btn-primary btn-block">Send message</button>
  </form>
  <div class="form-success" role="status" hidden>
    <h3>Thank you!</h3>
    <p>Your message has been sent. We'll be in touch shortly.</p>
  </div>
</div>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  (function () {
    var form = document.getElementById("contact-form");
    var error = form.querySelector(".form-error");
    var button = form.querySelector("button[type=submit]");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      error.hidden = true;
      button.disabled = true;
      button.textContent = "Sending…";
      fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } })
        .then(function (res) {
          if (res.ok) {
            form.hidden = true;
            form.nextElementSibling.hidden = false;
            return;
          }
          return res.json().then(function (data) {
            throw new Error(data.errors ? data.errors.map(function (x) { return x.message; }).join(" ") : "");
          });
        })
        .catch(function (err) {
          error.textContent = (err && err.message) || "Sorry, your message couldn't be sent. Please try again in a moment.";
          error.hidden = false;
          // Turnstile tokens are single-use, so get a fresh one before a retry.
          if (window.turnstile) window.turnstile.reset();
        })
        .finally(function () {
          button.disabled = false;
          button.textContent = "Send message";
        });
    });
  })();
</script>
