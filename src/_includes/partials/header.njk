<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="{{ site.name }} home">
      <img src="/img/sbp-horz-logo-sm.png" alt="{{ site.name }}" width="176" height="41">
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg class="icon"><use href="#i-menu"/></svg>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href="/#services">Services</a>
      <a href="/#compliance">Compliance</a>
      <a href="/#about">About</a>
      <a href="/insights/"{% if page.url.startsWith('/insights/') %} aria-current="page"{% endif %}>Insights</a>
      <a href="/#contact" class="btn btn-sm btn-primary">Get in touch</a>
    </nav>
  </div>
</header>
